{
  "name": "الموسوعة — 11 Publisher (كل ساعتين)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 2 }] }
      },
      "id": "pub-trigger",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mawso3a-stream.vercel.app/api/publish?action=publish",
        "options": { "timeout": 55000 },
        "headers": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.N8N_SECRET }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "body": {
          "mode": "json",
          "json": "={ \"limit\": 50, \"include_pending_review\": false }"
        }
      },
      "id": "pub-publish",
      "name": "Publish Approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mawso3a-stream.vercel.app/api/candidates?action=log",
        "options": { "timeout": 10000 },
        "headers": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.N8N_SECRET }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "body": {
          "mode": "json",
          "json": "={{ { query: 'publisher', found: $json.processed, imported: $json.published, skipped: $json.skipped } }}"
        }
      },
      "id": "pub-log",
      "name": "Log Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Every 2 Hours": { "main": [[{ "node": "Publish Approved", "type": "main", "index": 0 }]] },
    "Publish Approved": { "main": [[{ "node": "Log Run",        "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["publisher","content"]
}
