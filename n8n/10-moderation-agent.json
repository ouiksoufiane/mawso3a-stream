{
  "name": "الموسوعة — 10 Moderation Agent (يومي)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "daysInterval": 1 }] }
      },
      "id": "mod-trigger",
      "name": "Every Day",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://mawso3a-stream.vercel.app/api/admin/moderate?action=list-candidates&status=pending_review&limit=50",
        "options": { "timeout": 15000 },
        "headers": {
          "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $env.N8N_SECRET }}" }]
        }
      },
      "id": "mod-fetch",
      "name": "Fetch Pending Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst items = data.items || [];\n\n// Auto-approve high-confidence pending_review items (score >= 80, trusted platforms)\nconst autoApprove = items.filter(c =>\n  c.quality_score >= 80 &&\n  ['youtube', 'archive'].includes(c.platform) &&\n  c.title_ar && c.title_ar.length >= 3\n);\n\n// The rest stay for manual review\nconst manualReview = items.filter(c => !autoApprove.find(a => a.id === c.id));\n\nconsole.log(`[ModerationAgent] total=${items.length} autoApprove=${autoApprove.length} manual=${manualReview.length}`);\nreturn autoApprove.map(c => ({ json: { id: c.id } }));"
      },
      "id": "mod-decide",
      "name": "Decide Auto-Approve",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mawso3a-stream.vercel.app/api/admin/moderate?action=approve-candidate",
        "options": { "timeout": 10000 },
        "headers": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.N8N_SECRET }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "body": {
          "mode": "json",
          "json": "={{ { id: $json.id } }}"
        }
      },
      "id": "mod-approve",
      "name": "Approve Candidate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Every Day":          { "main": [[{ "node": "Fetch Pending Review",  "type": "main", "index": 0 }]] },
    "Fetch Pending Review":{ "main": [[{ "node": "Decide Auto-Approve", "type": "main", "index": 0 }]] },
    "Decide Auto-Approve":{ "main": [[{ "node": "Approve Candidate",    "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["moderation","quality"]
}
