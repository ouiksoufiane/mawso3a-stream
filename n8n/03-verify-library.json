{
  "name": "الموسوعة — Vérification Bibliothèque (hebdo)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "weeksInterval": 1 }] }
      },
      "id": "ms-03-01", "name": "Every Week",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://wadazxpofizrfoczhmkn.supabase.co/rest/v1/content?status=eq.active&select=id,yt_id,type&order=created_at.desc&limit=500",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "{{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "ms-03-02", "name": "Fetch Content List",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json;\nconst ytIds = (Array.isArray(items) ? items : []).filter(i => i.yt_id).map(i => i.yt_id);\nconst batchSize = 50;\nconst batches = [];\nfor (let i = 0; i < ytIds.length; i += batchSize) {\n  batches.push({ json: { ytIds: ytIds.slice(i, i + batchSize), batch: Math.floor(i / batchSize) + 1 } });\n}\nconsole.log(`[Verify] Checking ${ytIds.length} IDs in ${batches.length} batches`);\nreturn batches;"
      },
      "id": "ms-03-03", "name": "Split into Batches",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mawso3a-stream.vercel.app/api/import?action=verify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.N8N_SECRET }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true, "contentType": "raw", "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ ytIds: $json.ytIds, auto_hide: true }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "ms-03-04", "name": "Verify Batch",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet checked = 0, alive = 0;\nconst dead = [];\nfor (const item of items) {\n  const d = item.json;\n  checked += d.checked || 0;\n  alive   += d.alive   || 0;\n  if (d.dead?.length) dead.push(...d.dead);\n}\nconsole.log(`[Verify] DONE: ${alive} alive, ${dead.length} dead / ${checked} checked`);\nreturn [{ json: { checked, alive, dead, dead_count: dead.length, run_at: new Date().toISOString() } }];"
      },
      "id": "ms-03-05", "name": "Aggregate Results",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "id":"has-dead","leftValue":"={{ $json.dead_count }}","rightValue":0,"operator":{"type":"number","operation":"gt"} }],
          "combinator": "and"
        }
      },
      "id": "ms-03-06", "name": "Dead Found?",
      "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "const { dead, dead_count } = $input.first().json;\nconsole.log(`[Verify] ${dead_count} liens morts masqués automatiquement par auto_hide`);\nreturn [{ json: { hidden: dead_count, dead, report: `${dead_count} liens morts masqués` } }];"
      },
      "id": "ms-03-07", "name": "Log Dead",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1560, 220]
    },
    {
      "parameters": {
        "jsCode": "console.log('[Verify] ✅ Tous les liens الموسوعة sont actifs');\nreturn $input.all();"
      },
      "id": "ms-03-08", "name": "All Good",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1560, 400]
    }
  ],
  "connections": {
    "Every Week":        { "main": [[{ "node": "Fetch Content List",  "type": "main", "index": 0 }]] },
    "Fetch Content List":{ "main": [[{ "node": "Split into Batches",  "type": "main", "index": 0 }]] },
    "Split into Batches":{ "main": [[{ "node": "Verify Batch",        "type": "main", "index": 0 }]] },
    "Verify Batch":      { "main": [[{ "node": "Aggregate Results",   "type": "main", "index": 0 }]] },
    "Aggregate Results": { "main": [[{ "node": "Dead Found?",         "type": "main", "index": 0 }]] },
    "Dead Found?":       { "main": [
      [{ "node": "Log Dead",  "type": "main", "index": 0 }],
      [{ "node": "All Good",  "type": "main", "index": 0 }]
    ]}
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "_setup": "Set N8N_SECRET and SUPABASE_ANON_KEY in n8n > Settings > Variables"
}
