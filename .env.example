# الموسوعة ستريم — Environment Variables
# Copy this file to .env.local for local development
# Set these in Vercel Dashboard > Project > Settings > Environment Variables

# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API

# Service role key — server-side only, NEVER expose to frontend
SUPABASE_SERVICE_KEY=sb_secret_...

# Public anon key — safe to use in frontend (RLS restricts access)
# NOTE: This key is already hardcoded in js/api.js as it is intentionally public
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ─── N8N ─────────────────────────────────────────────────────────────────────
# Secret token used to authenticate n8n webhook calls to /api/* endpoints
N8N_SECRET=your_n8n_secret_here

# ─── YouTube Data API ────────────────────────────────────────────────────────
# https://console.cloud.google.com > APIs & Services > Credentials
YOUTUBE_API_KEY=AIza...

# ─── TMDB (posters and metadata) ─────────────────────────────────────────────
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─── OMDb (fallback metadata, 1000 req/day free) ─────────────────────────────
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# ─── Vimeo (embeddable public video discovery) ───────────────────────────────
# https://developer.vimeo.com > My Apps > Personal Access Token (public scope)
VIMEO_ACCESS_TOKEN=

# ─── Dailymotion (secondary discovery source) ────────────────────────────────
# https://developer.dailymotion.com > Create app > client credentials
DAILYMOTION_API_KEY=
DAILYMOTION_SECRET=

# ─── Notes ────────────────────────────────────────────────────────────────────
# N8N_SECRET is used as Bearer token for ALL /api/import and /api/admin/* calls
# Set it in both Vercel (env var) and n8n (Settings > Variables)
# SUPABASE_SERVICE_KEY is only used server-side (Vercel functions + n8n)
# The Supabase anon key is intentionally public (in js/api.js) — RLS restricts to read-only
