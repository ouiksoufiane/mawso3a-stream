# الموسوعة ستريم — Environment Variables
# Copy this file to .env.local for local development
# Set these in Vercel Dashboard > Project > Settings > Environment Variables

# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API

# Service role key — server-side only, NEVER expose to frontend
SUPABASE_SERVICE_KEY=sb_secret_...

# Public anon key — safe to use in frontend (RLS restricts access)
# NOTE: This key is already hardcoded in js/api.js as it is intentionally public
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ─── N8N ─────────────────────────────────────────────────────────────────────
# Secret token used to authenticate n8n webhook calls to /api/import
N8N_SECRET=your_n8n_secret_here

# ─── YouTube Data API (optional — for metadata enrichment) ──────────────────
# https://console.cloud.google.com > APIs & Services > Credentials
# YOUTUBE_API_KEY=AIza...

# ─── TMDB (optional — for posters and metadata) ─────────────────────────────
# https://www.themoviedb.org/settings/api
# TMDB_API_KEY=...

# ─── TMDB (optional — for posters and metadata via workflow 04) ──────────────
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─── Notes ────────────────────────────────────────────────────────────────────
# N8N_SECRET is used as the Bearer token for ALL /api/import and /api/admin/* calls
# It must be configured in both Vercel (env var) and n8n (Settings > Variables)
# The Supabase anon key is intentionally public (in js/api.js) — RLS restricts read-only access
